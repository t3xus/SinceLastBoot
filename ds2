# SinceLastBoot - HTML report (reportexport.ps1)
# Generates a detailed HTML report focused on activity since the last boot.

$ErrorActionPreference = 'Continue'

$Date = (Get-Date).ToString("yyyy-MM-dd_HH-mm-ss")
$ReportFilePath = Join-Path $env:USERPROFILE "Desktop\System_Report_$Date.html"
$LastBoot = (Get-CimInstance Win32_OperatingSystem).LastBootUpTime

function Write-HTMLSection {
    param([string]$Title, [string]$Content)
    @"
<h2>$Title</h2>
<pre>$([System.Web.HttpUtility]::HtmlEncode($Content))</pre>
"@
}

# Header
@"
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>SinceLastBoot Report</title>
    <style>
        body { font-family: Segoe UI, Arial, sans-serif; margin: 2rem; background: #fafafa; color: #222; }
        h1 { color: #1a365d; }
        h2 { color: #2c5282; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.3rem; }
        pre { background: #fff; padding: 1rem; border: 1px solid #e2e8f0; border-radius: 6px; white-space: pre-wrap; word-wrap: break-word; }
        .meta { color: #4a5568; font-size: 0.95rem; }
    </style>
</head>
<body>
<h1>SinceLastBoot System Report</h1>
<p class="meta">Generated: $(Get-Date)<br>Last boot: $LastBoot</p>
"@ | Set-Content -Path $ReportFilePath -Encoding UTF8

# System Information
$os  = Get-CimInstance Win32_OperatingSystem
$cs  = Get-CimInstance Win32_ComputerSystem
$cpu = (Get-CimInstance Win32_Processor | Select-Object -First 1).Name
$gpu = (Get-CimInstance Win32_VideoController | Select-Object -ExpandProperty Name) -join ", "

$sysInfo = @"
Operating System : $($os.Caption)
Windows Version  : $((Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion').DisplayVersion)
Manufacturer     : $($cs.Manufacturer)
Model            : $($cs.Model)
Processor        : $cpu
GPU              : $gpu
Total Memory     : $([math]::Round($cs.TotalPhysicalMemory / 1GB, 2)) GB
Current User     : $env:USERNAME
Hostname         : $env:COMPUTERNAME
Last Boot        : $LastBoot
"@

Add-Content -Path $ReportFilePath -Value (Write-HTMLSection "System Information" $sysInfo)

# Disks
$diskInfo = Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3" | ForEach-Object {
    $total = [math]::Round($_.Size / 1GB, 2)
    $free  = [math]::Round($_.FreeSpace / 1GB, 2)
    $used  = [math]::Round($total - $free, 2)
    "Drive $($_.DeviceID): Used $used GB / Total $total GB (Free $free GB)"
} | Out-String

Add-Content -Path $ReportFilePath -Value (Write-HTMLSection "Storage" $diskInfo)

# Recent files since boot
$dirs = @("$env:USERPROFILE\Documents", "$env:USERPROFILE\Desktop", "$env:USERPROFILE\Downloads")
$recent = foreach ($d in $dirs) {
    if (Test-Path $d) {
        Get-ChildItem -Path $d -Recurse -ErrorAction SilentlyContinue |
            Where-Object { $_.LastWriteTime -ge $LastBoot -and -not $_.PSIsContainer }
    }
}
$recent = $recent | Sort-Object LastWriteTime -Descending | Select-Object -First 25

$fileText = if ($recent) {
    $recent | ForEach-Object { "$($_.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))  $($_.FullName)" } | Out-String
} else { "No files modified since last boot in Documents/Desktop/Downloads." }

Add-Content -Path $ReportFilePath -Value (Write-HTMLSection "Recent Files (since last boot)" $fileText)

# Login events since boot
try {
    $logins = Get-WinEvent -FilterHashtable @{
        LogName   = 'Security'
        Id        = 4624, 4625
        StartTime = $LastBoot
    } -MaxEvents 200 -ErrorAction SilentlyContinue |
        Select-Object TimeCreated, Id, @{N='User';E={$_.Properties[5].Value}}, @{N='IP';E={$_.Properties[18].Value}}

    $loginText = if ($logins) {
        $logins | ForEach-Object {
            $type = if ($_.Id -eq 4624) { 'Success' } else { 'Failed' }
            "$($_.TimeCreated)  $type  User=$($_.User)  IP=$($_.IP)"
        } | Out-String
    } else { "No login events found since last boot (or insufficient permissions)." }
} catch {
    $loginText = "Unable to read Security log: $_"
}

Add-Content -Path $ReportFilePath -Value (Write-HTMLSection "Login Events (since last boot)" $loginText)

# System events since boot (limited)
try {
    $sysEvents = Get-WinEvent -FilterHashtable @{
        LogName   = 'System'
        StartTime = $LastBoot
    } -MaxEvents 100 -ErrorAction SilentlyContinue |
        Select-Object TimeCreated, LevelDisplayName, Id, ProviderName, Message

    $sysText = if ($sysEvents) {
        $sysEvents | ForEach-Object {
            "$($_.TimeCreated)  [$($_.LevelDisplayName)] $($_.ProviderName) ($($_.Id)): $($_.Message.Substring(0, [Math]::Min(200, $_.Message.Length)))"
        } | Out-String
    } else { "No system events returned." }
} catch {
    $sysText = "Unable to read System log: $_"
}

Add-Content -Path $ReportFilePath -Value (Write-HTMLSection "System Events (since last boot, max 100)" $sysText)

# Network stats
try {
    $net = Get-NetAdapterStatistics -ErrorAction SilentlyContinue | ForEach-Object {
        "Adapter: $($_.Name)`n  Sent: $([math]::Round($_.OutboundBytes / 1MB, 2)) MB`n  Received: $([math]::Round($_.InboundBytes / 1MB, 2)) MB"
    } | Out-String
    if (-not $net) { $net = "No adapter statistics available." }
} catch {
    $net = "Network stats unavailable: $_"
}

Add-Content -Path $ReportFilePath -Value (Write-HTMLSection "Network Statistics" $net)

# Local users
try {
    $users = Get-LocalUser -ErrorAction SilentlyContinue | ForEach-Object {
        "User: $($_.Name)  Enabled: $($_.Enabled)  LastLogon: $($_.LastLogon)"
    } | Out-String
    if (-not $users) { $users = "Could not enumerate local users." }
} catch {
    $users = "Local user query failed: $_"
}

Add-Content -Path $ReportFilePath -Value (Write-HTMLSection "Local Users" $users)

# Footer
@"
</body>
</html>
"@ | Add-Content -Path $ReportFilePath -Encoding UTF8

Write-Host "HTML report saved: $ReportFilePath" -ForegroundColor Green
